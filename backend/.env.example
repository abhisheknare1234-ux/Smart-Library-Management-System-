# Library Hub Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# Application
NODE_ENV=development
PORT=5000

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=library_hub
DB_USER=library_admin
DB_PASSWORD=your_secure_password_here
DB_CONNECTION_LIMIT=10

# JWT Authentication
# Generate a secure random string for production: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
# Comma-separated list of allowed origins for production
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth-specific rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Frontend URLs (for password reset emails, etc.)
FRONTEND_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3000/admin
MEMBER_DASHBOARD_URL=http://localhost:3000/member
LIBRARIAN_DASHBOARD_URL=http://localhost:3000/librarian

# Email (for password reset, notifications - configure when implementing)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password
# EMAIL_FROM="Library Hub <noreply@libraryhub.example.com>"

# Backup
BACKUP_DIR=./backups_files
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info